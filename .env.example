# API Authentication
# ==================
#
# Option 1: Legacy (single global key) — deprecated, use per-client keys instead
# X_API_KEY=sk-your-secret-key-here
#
# Option 2: Per-Client Keys (recommended) — hash-based validation
# Generate keys with: python generated_secret.py --environment prod
# Multiple keys can be comma-separated or newline-separated
# X_API_KEY_HASH=abc123def456...,xyz789uvw012...

X_API_KEY_HASH=

# OpenAI / Groq Configuration
OPENAI_API_KEY=gsk_xxxx
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL_ID=meta-llama/llama-4-scout-17b-16e-instruct